+        if str(error) != f"WORKER_RSS_OBSERVATION_INVALID:{registered['pid']}":
+            raise
+        refreshed = unit_state(unit)
+        if not normal_exit(refreshed, registered):
+            raise
+        return None, refreshed, True
+    return rss, unit_info, False
