+def sample_owned_rss(unit: str, registered: dict, unit_info: dict) -> tuple[int | None, dict, bool]:
+    """Recheck exact owned exit only when the RSS field vanishes during exit."""
+    if not registered:
+        return None, unit_info, False
+    try:
+        rss = worker_rss_highwater(registered['pid'])
+    except ValueError as error:
+        if str(error) != f"WORKER_RSS_OBSERVATION_INVALID:{registered['pid']}":
+            raise
+        refreshed = unit_state(unit)
+        if not normal_exit(refreshed, registered):
+            raise
+        return None, refreshed, True
+    return rss, unit_info, False
 
 
