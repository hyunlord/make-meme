+        assert compare_leaf(location,x,y)
+        assert not compare_leaf(location,x,x)
+    assert compare_leaf('root.arg_c.context[0]',torch.ones(91,4096),torch.ones(93,4096))
+    assert not compare_leaf('root.arg_c.context[0]',torch.ones(91,4096),torch.ones(91,4096))
+    mask=torch.zeros(28,6,2,2);bad=mask.clone();bad[:,1:]=1
+    assert not compare_leaf('root.arg_c.ref_masks[0]',mask,bad)
+    for location in ('root.arg_c.pose_latents[0]','root.arg_null.context[0]','root.noise','root.generator_state','root.timesteps','root.sigmas'):
