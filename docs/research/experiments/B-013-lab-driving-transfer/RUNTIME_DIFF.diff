+def test_lineage_seven_changed_nine_controlled():
+    from compare_lineage import compare_leaf,CHANGED
+    a=torch.ones(2,3);b=a+1
+    assert len(CHANGED)==7
+    for location in CHANGED-{'root.arg_c.context[0]'}:
+        x=torch.ones(28,6,2,2) if '.ref_masks[' in location else a
+        if '.ref_masks[' in location:x[:,1:]=0
